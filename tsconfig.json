{
  "extends": "@k8slens/typescript/config/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.cache/lens-image-explorer.tsbuildinfo"
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./package.json"
  ]
}
